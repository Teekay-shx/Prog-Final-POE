@model CategoryFormViewModel

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" placeholder="e.g. 10km, Under 20, Senior" />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>
<div class="row g-3 mb-3">
    <div class="col-sm-6">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" type="number" step="0.01" min="0.01" class="form-control" />
        <span asp-validation-for="DistanceKm" class="text-danger small"></span>
    </div>
    <div class="col-sm-6">
        <label asp-for="EntryFee" class="form-label"></label>
        <input asp-for="EntryFee" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="EntryFee" class="text-danger small"></span>
    </div>
</div>
<div class="row g-3 mb-3">
    <div class="col-sm-6">
        <label asp-for="MinAge" class="form-label"></label>
        <input asp-for="MinAge" type="number" min="0" max="120" class="form-control" />
        <span asp-validation-for="MinAge" class="text-danger small"></span>
    </div>
    <div class="col-sm-6">
        <label asp-for="MaxAge" class="form-label"></label>
        <input asp-for="MaxAge" type="number" min="0" max="120" class="form-control" />
        <span asp-validation-for="MaxAge" class="text-danger small"></span>
    </div>
</div>
<div class="mb-4">
    <label asp-for="MaxParticipants" class="form-label"></label>
    <input asp-for="MaxParticipants" type="number" min="1" class="form-control" />
    <div class="form-text">Leave empty for no limit.</div>
    <span asp-validation-for="MaxParticipants" class="text-danger small"></span>
</div>
