@model EventFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit event" : "Create event";
    var hasBanner = !string.IsNullOrEmpty(Model.ExistingBannerUrl);
}
<div class="container rd-section">
    <div class="rd-form-card">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-action="Index">My events</a></li>
                <li class="breadcrumb-item active" aria-current="page">@(Model.IsEdit ? "Edit" : "Create")</li>
            </ol>
        </nav>
        <h1 class="rd-page-title mb-4">@(Model.IsEdit ? "Edit event" : "Create event")</h1>

        <div class="card card-body p-4">
            <form asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" autofocus />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="EventDate" class="form-label"></label>
                        <input asp-for="EventDate" type="date" class="form-control" />
                        <span asp-validation-for="EventDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Type" class="form-label"></label>
                        <select asp-for="Type" asp-items="@(new SelectList(UiHelpers.EventTypes))" class="form-select"></select>
                        <span asp-validation-for="Type" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Distance" class="form-label"></label>
                        <input asp-for="Distance" type="number" step="0.01" min="0.01" class="form-control" />
                        <span asp-validation-for="Distance" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                @if (Model.IsEdit)
                {
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label">Event status</label>
                        <select asp-for="Status" asp-items="@(new SelectList(UiHelpers.EventStatuses))" class="form-select"></select>
                        <div class="form-text">Set to <strong>Open</strong> when you are ready for participants to enrol.</div>
                    </div>
                }

                <div class="mb-4">
                    <label asp-for="BannerFile" class="form-label">Event banner image <span class="text-muted fw-normal">(optional)</span></label>
                    @if (hasBanner)
                    {
                        <div class="mb-2">
                            <img id="banner-preview" src="@Model.ExistingBannerUrl" class="rd-banner" style="height:160px" alt="Current banner" />
                        </div>
                    }
                    else
                    {
                        <img id="banner-preview" class="rd-banner d-none mb-2" style="height:160px" alt="Preview of the chosen banner" />
                    }
                    <input asp-for="BannerFile" type="file" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif" data-preview="#banner-preview" />
                    <div class="form-text">JPEG, PNG, WebP or GIF, up to 5 MB. @(hasBanner ? "Choose a new file to replace the current banner." : "")</div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">@(Model.IsEdit ? "Save changes" : "Create event")</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
