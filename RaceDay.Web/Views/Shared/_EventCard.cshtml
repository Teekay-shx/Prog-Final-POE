@model ApiEvent
@{
    var banner = string.IsNullOrEmpty(Model.BannerImageUrl) ? Url.Content("~/img/banner-placeholder.svg") : Model.BannerImageUrl;
    var status = UiHelpers.EventBadge(Model.Status);
}
<article class="card rd-event-card h-100">
    <img src="@banner" class="rd-event-card-img" alt="@(string.IsNullOrEmpty(Model.BannerImageUrl) ? "" : "Banner for " + Model.Name)" loading="lazy" />
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
            <span class="rd-type"><span aria-hidden="true">@UiHelpers.TypeIcon(Model.Type)</span> @Model.Type</span>
            <span class="rd-badge @status.Css">@status.Label</span>
        </div>
        <h2 class="rd-card-title"><a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" class="stretched-link">@Model.Name</a></h2>
        <ul class="rd-meta list-unstyled mb-3">
            <li><i class="bi bi-calendar-event" aria-hidden="true"></i> @UiHelpers.LongDate(Model.EventDate)</li>
            @if (!string.IsNullOrWhiteSpace(Model.Location))
            {
                <li><i class="bi bi-geo-alt" aria-hidden="true"></i> @Model.Location</li>
            }
            @if (Model.Distance.HasValue)
            {
                <li><i class="bi bi-signpost-split" aria-hidden="true"></i> @Model.Distance.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) km</li>
            }
        </ul>
        <span class="rd-card-cta mt-auto">View event <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
    </div>
</article>
